# Telegram API credentials — create an app at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: a Telethon StringSession (from `uv run translate-bot login`) so CI
# can run without an interactive login. If unset, a file session is stored in data/.
TELEGRAM_SESSION=
# Public group username (no @). Defaults to Nexa_China.
TELEGRAM_CHAT=Nexa_China
# How many text messages to translate. Defaults to 100.
MESSAGE_LIMIT=100

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
