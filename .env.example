# Telegram API credentials — create an app at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: a Telethon StringSession (from `uv run translate-bot login`) so CI
# can run without an interactive login. If unset, a file session is stored in data/.
TELEGRAM_SESSION=
# Public groups to mirror, as username:SourceLanguage pairs (no @).
CHATS=Nexa_China:Chinese,nexatr:Turkish
# How many text messages to translate per group. Defaults to 100.
MESSAGE_LIMIT=100

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only needed if your key is an org-level key not scoped to a workspace
# (Console -> Settings -> Workspaces; looks like wrkspc_...). Workspace-scoped keys can leave this blank.
ANTHROPIC_WORKSPACE_ID=
# Optional: override the model. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
