:root {
  color-scheme: light;
  --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --line: #e1e0d9; --ring: rgba(11,11,11,.10); --wash: rgba(11,11,11,.04);
  --accent: #2a78d6; --accent-ink: #1c5cab;
  --pos: #0ca30c; --neg: #d03b3b; --mix: #c98500; --neu: #898781; --mid: #f0efec;
  --zh: #52514e;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
    --line: #2c2c2a; --ring: rgba(255,255,255,.10); --wash: rgba(255,255,255,.05);
    --accent: #3987e5; --accent-ink: #86b6ef;
    --pos: #0ca30c; --neg: #d03b3b; --mix: #fab219; --neu: #898781; --mid: #383835;
    --zh: #c3c2b7;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d; --surface: #1a1a19; --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
  --line: #2c2c2a; --ring: rgba(255,255,255,.10); --wash: rgba(255,255,255,.05);
  --accent: #3987e5; --accent-ink: #86b6ef;
  --pos: #0ca30c; --neg: #d03b3b; --mix: #fab219; --neu: #898781; --mid: #383835;
  --zh: #c3c2b7;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--page); color: var(--ink);
  font: 15px/1.55 system-ui, -apple-system, "Segoe UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
  padding-inline: clamp(16px, 4vw, 32px); padding-block: 0 64px;
}
a { color: var(--accent-ink); text-decoration: none; }
a:hover { text-decoration: underline; }
.wrap { max-width: 900px; margin: 0 auto; }
header.top { padding-block: 40px 24px; border-bottom: 1px solid var(--line); }
.eyebrow { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
h1 { font-size: clamp(24px, 4vw, 34px); line-height: 1.15; margin: 0 0 10px; letter-spacing: -.01em; }
.meta { color: var(--ink-2); font-size: 14px; display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; }
.meta span::before { content: ""; }
h2 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; font-weight: 600; }
section { padding-block: 32px; }
h2 .sub { font-weight: 400; letter-spacing: 0; text-transform: none; }
.top .intro { margin-top: 16px; }
section + section { border-top: 1px solid var(--line); }
.headline { font-size: clamp(19px, 2.6vw, 24px); line-height: 1.3; font-weight: 600; margin: 0 0 12px; letter-spacing: -.01em; }
.lede { font-size: 16px; color: var(--ink-2); margin: 0; max-width: 70ch; }
.grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; }
@media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
.card { background: var(--surface); border: 1px solid var(--ring); border-radius: 12px; padding: 18px 20px; }
.topics { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.topic { width: 100%; text-align: left; background: transparent; border: 1px solid transparent; border-radius: 10px; padding: 12px 14px; color: inherit; font: inherit; cursor: pointer; display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; }
.topic:hover { background: var(--wash); }
.topic[aria-pressed="true"] { border-color: var(--accent); background: var(--wash); }
.topic .t { font-weight: 600; }
.topic .n { color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.topic .s { grid-column: 1 / -1; color: var(--ink-2); font-size: 14px; }
.mood-label { font-size: 26px; font-weight: 700; letter-spacing: -.01em; margin: 0 0 4px; }
.mood-score { color: var(--muted); font-size: 13px; margin: 0 0 12px; font-variant-numeric: tabular-nums; }
.meter { position: relative; height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--neg), var(--mid) 50%, var(--pos)); margin: 6px 0 4px; }
.meter i { position: absolute; top: 50%; width: 16px; height: 16px; border-radius: 50%; background: var(--surface); border: 3px solid var(--ink); transform: translate(-50%, -50%); box-shadow: 0 0 0 2px var(--surface); }
.meter-ticks { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-bottom: 14px; }
.mood-desc { margin: 0 0 20px; color: var(--ink-2); font-size: 14px; }
.dist { display: flex; height: 12px; border-radius: 4px; overflow: hidden; gap: 2px; background: var(--surface); margin-bottom: 10px; }
.dist b { display: block; height: 100%; }
.legend { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; font-size: 13px; }
.legend li { display: flex; align-items: center; gap: 8px; }
.legend .n { margin-left: auto; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }
.positive { --c: var(--pos); } .negative { --c: var(--neg); } .mixed { --c: var(--mix); } .neutral { --c: var(--neu); }
.dot, .dist b { background: var(--c); }
.chip { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; color: var(--ink-2); padding: 2px 8px 2px 6px; border-radius: 999px; border: 1px solid var(--ring); background: var(--surface); white-space: nowrap; }
.chip::before { content: attr(data-glyph); width: 14px; height: 14px; border-radius: 50%; background: var(--c); color: #fff; display: inline-grid; place-items: center; font-size: 11px; line-height: 1; }
.hl { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.hl a { display: block; color: inherit; background: var(--surface); border: 1px solid var(--ring); border-radius: 10px; padding: 12px 14px; }
.hl a:hover { text-decoration: none; border-color: var(--accent); }
.hl .q { font-size: 15px; margin: 0 0 4px; }
.hl .w { font-size: 13px; color: var(--ink-2); margin: 0; }
.hl .w b { font-weight: 600; color: var(--ink); }
.controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-bottom: 16px; position: sticky; top: 0; background: var(--page); padding-block: 10px; z-index: 2; border-bottom: 1px solid var(--line); }
.controls .sp { flex: 1; }
.filters { display: flex; flex-wrap: wrap; gap: 6px; }
.fbtn { font: inherit; font-size: 13px; padding: 4px 11px; border-radius: 999px; border: 1px solid var(--ring); background: var(--surface); color: var(--ink-2); cursor: pointer; }
.fbtn[aria-pressed="true"] { background: var(--ink); color: var(--page); border-color: var(--ink); }
.toggle { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); cursor: pointer; user-select: none; }
.toggle input { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }
.active-topic { display: none; font-size: 13px; color: var(--ink-2); padding: 8px 12px; border-radius: 8px; background: var(--wash); margin-bottom: 12px; }
.active-topic.on { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.active-topic button { font: inherit; font-size: 13px; background: none; border: 0; color: var(--accent-ink); cursor: pointer; padding: 0; }
.msgs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.msg { background: var(--surface); border: 1px solid var(--ring); border-radius: 12px; padding: 12px 16px; scroll-margin-top: 70px; }
.msg[hidden] { display: none; }
.msg.flash { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(42,120,214,.25); }
.msg .head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; margin-bottom: 6px; font-size: 13px; }
.msg .who { font-weight: 600; color: var(--ink); font-size: 14px; }
.msg time { color: var(--muted); font-variant-numeric: tabular-nums; }
.msg .lnk { margin-left: auto; color: var(--muted); font-size: 12px; }
.msg .reply { border-left: 3px solid var(--line); padding: 2px 10px; margin: 0 0 8px; color: var(--ink-2); font-size: 13px; }
.msg .reply b { font-weight: 600; }
.msg .en { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
.msg .zh { margin: 6px 0 0; color: var(--zh); font-size: 14px; white-space: pre-wrap; overflow-wrap: anywhere; }
body.hide-zh .msg .zh { display: none; }
.msg .note { margin: 8px 0 0; font-size: 13px; color: var(--ink-2); font-style: italic; }
.msg .note::before { content: "Note: "; font-style: normal; font-weight: 600; }
.empty { display: none; color: var(--muted); padding: 24px 0; text-align: center; }
.empty.on { display: block; }
footer { color: var(--muted); font-size: 13px; padding-top: 32px; border-top: 1px solid var(--line); }
footer p { margin: 0 0 6px; }
@media (prefers-reduced-motion: no-preference) { .msg { transition: border-color .3s, box-shadow .3s; } }
.nav { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 18px; padding: 0; list-style: none; }
.nav a { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--ring); background: var(--surface); color: var(--ink-2); }
.nav a:hover { text-decoration: none; border-color: var(--accent); }
.nav a[aria-current="page"] { background: var(--ink); color: var(--page); border-color: var(--ink); }
.nav .lang { font-weight: 400; opacity: .75; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; list-style: none; margin: 0; padding: 0; }
.cards > li { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--ring); border-radius: 12px; padding: 18px 20px; transition: border-color .15s; }
.cards > li:hover { border-color: var(--accent); }
.card-link { display: block; color: inherit; flex: 1; }
.card-link:hover { text-decoration: none; }
.card-link:hover h3 { text-decoration: underline; }
.card-actions { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; margin: 12px 0 0; padding-top: 12px; border-top: 1px solid var(--line); }
.card-actions a { font-size: 13px; font-weight: 600; }
.card-actions .tg { margin-left: auto; color: var(--ink-2); }
.cards h3 { margin: 0 0 4px; font-size: 18px; letter-spacing: -.01em; }
.cards .sub { color: var(--muted); font-size: 13px; margin: 0 0 12px; }
.cards .hd { font-size: 15px; font-weight: 600; margin: 0 0 10px; line-height: 1.35; }
.cards .mood { display: flex; align-items: baseline; gap: 8px; margin: 0 0 8px; }
.cards .mood b { font-size: 20px; letter-spacing: -.01em; }
.cards .mood span { color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
.cards .dist { margin: 10px 0 8px; }
.cards .legend { grid-template-columns: repeat(4, auto); justify-content: start; gap: 4px 14px; font-size: 12px; }
.cards .legend .n { margin-left: 4px; }

