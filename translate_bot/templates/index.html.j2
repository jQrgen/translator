<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.chat.title }} — English</title>
<meta name="description" content="{{ summary.headline }}">
<style>
{% include '_style.css.j2' %}</style>
</head>
<body>
<div class="wrap">

<header class="top">
  {% include '_nav.html.j2' %}
  <p class="eyebrow">Telegram · {{ report.chat.language }} → English mirror</p>
  <h1>{{ report.chat.title }}</h1>
  <p class="meta">
    <span><a href="{{ report.chat.url }}" rel="noopener">{{ report.chat.url | replace("https://", "") }}</a></span>
    {% if report.chat.member_count %}<span>{{ "{:,}".format(report.chat.member_count) }} members</span>{% endif %}
    <span>Last {{ messages | length }} messages · <time datetime="{{ report.window_start | iso }}">{{ report.window_start | utc }}</time> → <time datetime="{{ report.window_end | iso }}">{{ report.window_end | utc }}</time></span>
    <span>Updated <time datetime="{{ report.generated_at | iso }}">{{ report.generated_at | utc }}</time></span>
  </p>
</header>

<section id="summary">
  <h2>Summary</h2>
  <p class="headline">{{ summary.headline }}</p>
  <p class="lede">{{ summary.summary }}</p>
</section>

<section id="analysis">
  <div class="grid">
    <div class="card">
      <h2>Topics</h2>
      <ul class="topics">
        {% for topic in summary.topics %}
        <li>
          <button class="topic" type="button" data-topic="{{ loop.index0 }}" aria-pressed="false" title="Show only messages in this topic">
            <span class="t">{{ topic.title }}</span>
            <span class="n">{{ topic_counts[loop.index0] }} msg{{ "s" if topic_counts[loop.index0] != 1 }} · <span class="chip {{ topic.sentiment.value }}" data-glyph="{{ sentiment_meta[topic.sentiment.value].glyph }}">{{ sentiment_meta[topic.sentiment.value].label }}</span></span>
            <span class="s">{{ topic.summary }}</span>
          </button>
        </li>
        {% endfor %}
      </ul>
    </div>
    <div class="card">
      <h2>Mood</h2>
      <p class="mood-label">{{ summary.mood_label }}</p>
      <p class="mood-score">Mood score {{ "%+.2f" | format(summary.mood_score) }} on a −1 … +1 scale</p>
      <div class="meter" role="img" aria-label="Mood score {{ '%+.2f' | format(summary.mood_score) }} of 1"><i style="left: {{ mood_pct }}%"></i></div>
      <div class="meter-ticks"><span>Negative</span><span>Neutral</span><span>Positive</span></div>
      <p class="mood-desc">{{ summary.mood_description }}</p>
      <h2>Sentiment by message</h2>
      <div class="dist" role="img" aria-label="{% for d in distribution %}{{ d.label }} {{ d.count }}{{ ', ' if not loop.last }}{% endfor %}">
        {% for d in distribution if d.count %}<b class="{{ d.key }}" style="flex: {{ d.count }}" title="{{ d.label }}: {{ d.count }}"></b>{% endfor %}
      </div>
      <ul class="legend">
        {% for d in distribution %}
        <li><span class="dot {{ d.key }}"></span>{{ d.label }}<span class="n">{{ d.count }} · {{ d.pct }}%</span></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% if summary.highlights %}
<section id="highlights">
  <h2>Worth reading first</h2>
  <ul class="hl">
    {% for h in summary.highlights %}{% set m = by_id[h.message_id] %}
    <li><a href="#m-{{ m.id }}">
      <p class="q">“{{ m.translation }}”</p>
      <p class="w"><b>{{ m.sender_name }}</b> · {{ h.why }}</p>
    </a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section id="messages">
  <h2>Messages <span class="sub">· newest first</span></h2>
  <div class="controls">
    <div class="filters" role="group" aria-label="Filter by sentiment">
      <button class="fbtn" type="button" data-sent="all" aria-pressed="true">All</button>
      {% for d in distribution %}<button class="fbtn" type="button" data-sent="{{ d.key }}" aria-pressed="false">{{ d.label }} ({{ d.count }})</button>{% endfor %}
    </div>
    <span class="sp"></span>
    <label class="toggle"><input type="checkbox" id="show-zh" checked> Show original {{ report.chat.language }}</label>
  </div>
  <div class="active-topic" id="active-topic"><span>Topic: <b id="active-topic-name"></b></span><button type="button" id="clear-topic">Show all messages</button></div>
  <ol class="msgs" id="msg-list" reversed>
    {% for m in messages | reverse %}
    <li class="msg" id="m-{{ m.id }}" data-sent="{{ m.sentiment.value }}" data-topics="{{ topic_ids[m.id] | join(' ') }}">
      <div class="head">
        <span class="who">{{ m.sender_name }}</span>
        <time datetime="{{ m.date | iso }}">{{ m.date | utc }}</time>
        <span class="chip {{ m.sentiment.value }}" data-glyph="{{ sentiment_meta[m.sentiment.value].glyph }}" title="score {{ '%+.2f' | format(m.sentiment_score) }}">{{ sentiment_meta[m.sentiment.value].label }}</span>
        {% if m.link %}<a class="lnk" href="{{ m.link }}" rel="noopener" title="Open on Telegram">#{{ m.id }} ↗</a>{% endif %}
      </div>
      {% if m.reply_to_id and m.reply_to_id in by_id %}{% set r = by_id[m.reply_to_id] %}
      <p class="reply">↩ <b>{{ r.sender_name }}</b>: {{ r.translation | truncate(120) }}</p>
      {% endif %}
      <p class="en">{{ m.translation }}</p>
      <p class="zh" lang="{{ report.chat.lang_code }}">{{ m.text }}</p>
      {% if m.note %}<p class="note">{{ m.note }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <p class="empty" id="empty">No messages match these filters.</p>
</section>

<footer>
  <p>Translations, sentiment scores and the summary are generated automatically by {{ report.model }} and may contain mistakes. Original messages belong to their authors on Telegram.</p>
  <p><a href="data.json">Raw data (JSON)</a> · <a href="https://github.com/jQrgen/translator" rel="noopener">Source code on GitHub</a></p>
</footer>

</div>
<script>
(function () {
  var msgs = Array.prototype.slice.call(document.querySelectorAll('.msg'));
  var sent = 'all', topic = null;
  var topicNames = {{ summary.topics | map(attribute="title") | list | tojson }};

  function apply() {
    var shown = 0;
    msgs.forEach(function (m) {
      var ok = (sent === 'all' || m.dataset.sent === sent) &&
               (topic === null || (' ' + m.dataset.topics + ' ').indexOf(' ' + topic + ' ') !== -1);
      m.hidden = !ok; if (ok) shown++;
    });
    document.getElementById('empty').classList.toggle('on', shown === 0);
    var bar = document.getElementById('active-topic');
    bar.classList.toggle('on', topic !== null);
    if (topic !== null) document.getElementById('active-topic-name').textContent = topicNames[topic] + ' (' + shown + ')';
    document.querySelectorAll('.topic').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.topic === String(topic))); });
  }
  document.querySelectorAll('.fbtn').forEach(function (b) {
    b.addEventListener('click', function () {
      sent = b.dataset.sent;
      document.querySelectorAll('.fbtn').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      apply();
    });
  });
  document.querySelectorAll('.topic').forEach(function (b) {
    b.addEventListener('click', function () {
      topic = (String(topic) === b.dataset.topic) ? null : Number(b.dataset.topic);
      apply();
      if (topic !== null) document.getElementById('messages').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
  document.getElementById('clear-topic').addEventListener('click', function () { topic = null; apply(); });

  var zh = document.getElementById('show-zh');
  try { if (localStorage.getItem('showZh') === '0') zh.checked = false; } catch (e) {}
  function syncZh() {
    document.body.classList.toggle('hide-zh', !zh.checked);
    try { localStorage.setItem('showZh', zh.checked ? '1' : '0'); } catch (e) {}
  }
  zh.addEventListener('change', syncZh); syncZh();

  // Show timestamps in the viewer's local time zone.
  var fmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
  document.querySelectorAll('time[datetime]').forEach(function (t) {
    var d = new Date(t.getAttribute('datetime'));
    if (!isNaN(d)) { t.title = t.textContent; t.textContent = fmt.format(d); }
  });

  // Highlight links: reveal the target even if filtered out, then flash it.
  document.querySelectorAll('.hl a').forEach(function (a) {
    a.addEventListener('click', function () {
      sent = 'all'; topic = null;
      document.querySelectorAll('.fbtn').forEach(function (x) { x.setAttribute('aria-pressed', String(x.dataset.sent === 'all')); });
      apply();
      var el = document.querySelector(a.getAttribute('href'));
      if (el) { el.classList.add('flash'); setTimeout(function () { el.classList.remove('flash'); }, 1600); }
    });
  });
})();
</script>
</body>
</html>
